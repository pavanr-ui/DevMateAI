{
  "name": "devmate-ai",
  "version": "0.1.0",
  "private": true,
  "description": "DevMate AI - Your AI-Powered Development Companion",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "emulators": "node scripts/emulators.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devmate-ai \"vitest run --config vitest.rules.config.js\"",
    "test:rules:running": "vitest run --config vitest.rules.config.js",
    "emulators:fresh": "firebase emulators:start --project demo-devmate-ai",
    "seed": "node scripts/seed-emulator.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@ionic/vue": "^9.0.11",
    "@ionic/vue-router": "^9.0.11",
    "@lucide/vue": "^1.72.0",
    "dompurify": "^3.4.17",
    "firebase": "~12.19.0",
    "marked": "^18.2.0",
    "pinia": "^4.1.0",
    "shiki": "^4.6.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "firebase-tools": "^15.36.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
