rules_version = '2';

// Firestore security rules.
// Principle: deny by default, then open exactly what each feature needs.
// Every rule here is covered by tests in tests/rules/.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    // ---------- users/{uid}: profile ----------
    // Fields a client may write. Anything else is rejected.
    function profileFields() {
      return ['displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'];
    }

    function validDisplayName(data) {
      return data.displayName is string && data.displayName.size() <= 80;
    }

    function validPhotoURL(data) {
      return data.photoURL == null
        || (data.photoURL is string && data.photoURL.size() <= 2048);
    }

    function validNewProfile() {
      let data = incoming();
      return data.keys().hasOnly(profileFields())
        && data.keys().hasAll(profileFields())
        && validDisplayName(data)
        && validPhotoURL(data)
        && data.email == request.auth.token.email   // can't claim another email
        && data.createdAt == request.time            // must use serverTimestamp()
        && data.updatedAt == request.time;
    }

    function validProfileUpdate() {
      let data = incoming();
      let changed = data.diff(resource.data).affectedKeys();
      return data.keys().hasOnly(profileFields())
        && changed.hasOnly(['displayName', 'photoURL', 'updatedAt'])  // email/createdAt locked
        && validDisplayName(data)
        && validPhotoURL(data)
        && data.updatedAt == request.time;
    }

    // ---------- users/{uid}/projects/{id}: user-created workspaces ----------
    function projectFields() {
      return ['name', 'description', 'techStack', 'createdAt', 'updatedAt'];
    }

    function validProjectContent(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.description is string && data.description.size() <= 500
        // Rules can't loop over list items; the client limits each tag to 30 chars.
        && data.techStack is list && data.techStack.size() <= 10;
    }

    function validNewProject() {
      let data = incoming();
      return data.keys().hasOnly(projectFields())
        && data.keys().hasAll(projectFields())
        && validProjectContent(data)
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function validProjectUpdate() {
      let data = incoming();
      return data.keys().hasOnly(projectFields())
        && data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'techStack', 'updatedAt'])  // createdAt locked
        && validProjectContent(data)
        && data.updatedAt == request.time;
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;                          // nobody can list all users
      allow create: if isOwner(uid) && validNewProfile();
      allow update: if isOwner(uid) && validProfileUpdate();
      allow delete: if false;                        // account deletion: backend only (Phase 8)

      match /projects/{projectId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validNewProject();
        allow update: if isOwner(uid) && validProjectUpdate();
        allow delete: if isOwner(uid);
      }

      // Written ONLY by Cloud Functions (Admin SDK bypasses rules), so users
      // can read their history and usage but can never fake or erase it.
      match /activity/{activityId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
      match /usage/{dayKey} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // AI chats: the aiChat function saves every message, so the stored
      // history is exactly what the AI saw. Rename/delete arrive in Phase 8.
      match /conversations/{conversationId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Everything else stays locked until a feature opens it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
