rules_version = '2';

// Phase 1: deny everything by default ("secure by default").
// Real per-user rules (users/{uid}/...) are added in Phase 2 and hardened
// in Phase 8, each with automated rules tests in tests/rules/.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
