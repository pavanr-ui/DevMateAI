# Copy this file to `.env.local` and fill in values.
# Only PUBLIC values go here: every VITE_ variable is bundled into the
# browser app and anyone can read it. NEVER put the Gemini API key or any
# other secret in this file. Secrets live in Cloud Functions (Secret Manager).

# Local development: use the Firebase Emulator Suite (no real project needed)
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1

# Firebase web app config (Firebase console > Project settings > Your apps)
# Leave empty while using emulators; the "demo-devmate-ai" project is used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-devmate-ai
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_FUNCTIONS_REGION=us-central1
